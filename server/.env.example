# Cloudflare Turnstile 服务端配置（本文件为模板，复制为 .env 后填写，.env 已被 gitignore）
# 未配置 TURNSTILE_SECRET 时后端处于旁路模式（开发放行）；生产务必配置。

# 站点密钥（由 scripts/turnstile-create.mjs 创建后获得，保密，仅服务端）
TURNSTILE_SECRET=

# 允许的前端 hostname 白名单（逗号分隔）。生产值不要包含 localhost / 127.0.0.1
TURNSTILE_HOSTNAMES=ai-werewolf.pages.dev,localhost

# 可选：覆盖 siteverify 端点（默认 https://challenges.cloudflare.com/turnstile/v0/siteverify）
# TURNSTILE_SITEVERIFY_URL=
