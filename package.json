{
  "name": "ai-werewolf",
  "private": true,
  "version": "0.1.0",
  "description": "AI 狼人杀网页版 — 全 AI 自动对局 · 观战版",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "dev": "concurrently -k -n server,web -c gray,yellow \"npm --prefix server run dev\" \"npm --prefix web run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:lib && npm --prefix web install && npm --prefix web run build",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test",
    "test:driver": "node server/node_modules/tsx/dist/cli.mjs scripts/driver-smoke.ts",
    "typecheck:functions": "node node_modules/typescript/bin/tsc -p tsconfig.functions.json",
    "build:lib": "node scripts/build-lib.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:turnstile": "node scripts/turnstile-validate.mjs",
    "turnstile:create": "node scripts/turnstile-create.mjs",
    "tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tunnel.ps1",
    "test:web": "npm --prefix web run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
