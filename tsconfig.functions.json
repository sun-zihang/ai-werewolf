{
  // 仅用于类型检查 Cloudflare Pages Functions 侧代码（functions/ + worker/）。
  // 真正的打包由 Pages 内置的 esbuild 完成，这里 noEmit。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [],
    "noEmit": true
  },
  "include": ["functions/**/*.ts", "worker/**/*.ts"]
}
