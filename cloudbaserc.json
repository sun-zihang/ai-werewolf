{
  "envId": "在此填写你的云开发环境 ID",
  "framework": {
    "name": "ai-werewolf",
    "plugins": {
      "container": {
        "use": "@cloudbase/framework-plugin-container",
        "inputs": {
          "name": "ai-werewolf",
          "path": "/",
          "dockerfile": "Dockerfile",
          "container": {
            "cpu": 0.5,
            "mem": 1,
            "minNum": 1,
            "maxNum": 1,
            "envVariables": {
              "AWW_DATA_DIR": "/data",
              "PORT": "3001"
            }
          }
        }
      }
    }
  }
}
